# NILKANTH WORLD EXIM — Environment Configuration
# Copy this file to .env.local for local development or set these variables in your deployment dashboard (e.g. Vercel).

# 1. Site Production Domain
NEXT_PUBLIC_SITE_URL=https://nilkanthworldexim.com

# 2. Email Delivery Integration (Resend)
# Obtain your API key from https://resend.com
RESEND_API_KEY=

# 3. Recipient Inbox for Inquiries
CONTACT_TO_EMAIL=nilkanthworldexim@gmail.com

# 4. Verified Sender Email (must be configured and verified with your DNS domain in Resend)
CONTACT_FROM_EMAIL=inquiries@nilkanthworldexim.com
